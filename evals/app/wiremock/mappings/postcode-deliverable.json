{
  "name": "postcode-deliverable",
  "priority": 5,
  "request": {
    "method": "GET",
    "urlPathPattern": "/v1/postcodes/[A-Z]{2}/[^/]+"
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json"
    },
    "body": "{\"postcode\": \"{{request.pathSegments.[3]}}\", \"country\": \"{{request.pathSegments.[2]}}\", \"deliverable\": true, \"zone\": \"{{request.pathSegments.[2]}}-1\"}",
    "transformers": ["response-template"]
  }
}
