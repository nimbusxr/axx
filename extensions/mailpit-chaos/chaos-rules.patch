diff --git a/internal/smtpd/chaos/rules.go b/internal/smtpd/chaos/rules.go
new file mode 100644
index 0000000..f57e222
--- /dev/null
+++ b/internal/smtpd/chaos/rules.go
@@ -0,0 +1,101 @@
+package chaos
+
+// Rules, added by axx (github.com/nimbusxr/axx): a rule refuses the mail of
+// the senders or recipients it matches, every time, until it is removed.
+// Unlike the triggers, which fail a share of all mail, a rule fails only
+// the mail it names, so tests that each refuse their own mail can run side
+// by side.
+
+import (
+	"crypto/rand"
+	"encoding/hex"
+	"fmt"
+	"regexp"
+	"sort"
+	"strings"
+	"sync"
+	"time"
+)
+
+// Rule refuses the mail of the senders or recipients it matches.
+//
+// swagger:model ChaosRule
+type Rule struct {
+	// ID is the rule's ID, set when it is added.
+	ID string
+	// Stage is where the rule refuses mail: "sender" or "recipient".
+	// required: true
+	// example: recipient
+	Stage string
+	// Match is an address, or a pattern where * stands for any text,
+	// compared without regard to case.
+	// required: true
+	// example: *@example.com
+	Match string
+	// ErrorCode is the SMTP error code to return, from 400 to 599.
+	// required: true
+	// example: 451
+	ErrorCode int
+
+	re    *regexp.Regexp
+	added time.Time
+}
+
+var (
+	rulesMu sync.RWMutex
+	rules   = map[string]Rule{}
+)
+
+// AddRule adds a rule and returns it with its ID.
+func AddRule(r Rule) (Rule, error) {
+	r.Stage = strings.ToLower(strings.TrimSpace(r.Stage))
+	if r.Stage != "sender" && r.Stage != "recipient" {
+		return r, fmt.Errorf("a rule's stage is sender or recipient, not %q", r.Stage)
+	}
+	if strings.TrimSpace(r.Match) == "" {
+		return r, fmt.Errorf("a rule matches an address or a pattern")
+	}
+	if r.ErrorCode < 400 || r.ErrorCode > 599 {
+		return r, fmt.Errorf("error code must be between 400 and 599")
+	}
+	r.re = regexp.MustCompile("(?i)^" + strings.ReplaceAll(regexp.QuoteMeta(strings.TrimSpace(r.Match)), `\*`, ".*") + "$")
+	var id [8]byte
+	_, _ = rand.Read(id[:])
+	r.ID, r.added = hex.EncodeToString(id[:]), time.Now()
+	rulesMu.Lock()
+	rules[r.ID] = r
+	rulesMu.Unlock()
+	return r, nil
+}
+
+// DeleteRule removes a rule, and reports whether there was one.
+func DeleteRule(id string) bool {
+	rulesMu.Lock()
+	defer rulesMu.Unlock()
+	_, ok := rules[id]
+	delete(rules, id)
+	return ok
+}
+
+// Rules are the rules, oldest first.
+func Rules() []Rule {
+	rulesMu.RLock()
+	defer rulesMu.RUnlock()
+	out := make([]Rule, 0, len(rules))
+	for _, r := range rules {
+		out = append(out, r)
+	}
+	sort.Slice(out, func(i, j int) bool { return out[i].added.Before(out[j].added) })
+	return out
+}
+
+// Refuse reports whether a rule refuses the address at the stage, and the
+// error code of the oldest one that does.
+func Refuse(stage, address string) (bool, int) {
+	for _, r := range Rules() {
+		if r.Stage == stage && r.re.MatchString(address) {
+			return true, r.ErrorCode
+		}
+	}
+	return false, 0
+}
diff --git a/internal/smtpd/chaos/rules_test.go b/internal/smtpd/chaos/rules_test.go
new file mode 100644
index 0000000..e2d6fd0
--- /dev/null
+++ b/internal/smtpd/chaos/rules_test.go
@@ -0,0 +1,48 @@
+package chaos
+
+import "testing"
+
+func TestRules(t *testing.T) {
+	shop, err := AddRule(Rule{Stage: "Recipient", Match: "*@hawthorn-home.example", ErrorCode: 451})
+	if err != nil {
+		t.Fatal(err)
+	}
+	sender, err := AddRule(Rule{Stage: "sender", Match: "no-reply@parcels.example", ErrorCode: 550})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer DeleteRule(sender.ID)
+	for _, tc := range []struct {
+		stage, address string
+		refused        bool
+		code           int
+	}{
+		{"recipient", "orders@hawthorn-home.example", true, 451},
+		{"recipient", "Orders@HAWTHORN-HOME.example", true, 451},
+		{"recipient", "orders@hawthorn-home.example.org", false, 0},
+		{"recipient", "orders@wisteria-way.example", false, 0},
+		{"sender", "orders@hawthorn-home.example", false, 0},
+		{"sender", "no-reply@parcels.example", true, 550},
+		{"sender", "reply@parcels.example", false, 0},
+	} {
+		refused, code := Refuse(tc.stage, tc.address)
+		if refused != tc.refused || code != tc.code {
+			t.Errorf("%s %s: refused %v with %d", tc.stage, tc.address, refused, code)
+		}
+	}
+	if !DeleteRule(shop.ID) || DeleteRule(shop.ID) {
+		t.Error("a rule is deleted once")
+	}
+	if refused, _ := Refuse("recipient", "orders@hawthorn-home.example"); refused {
+		t.Error("a deleted rule still refuses")
+	}
+	for _, bad := range []Rule{
+		{Stage: "authentication", Match: "*", ErrorCode: 535},
+		{Stage: "recipient", Match: " ", ErrorCode: 451},
+		{Stage: "recipient", Match: "*", ErrorCode: 250},
+	} {
+		if _, err := AddRule(bad); err == nil {
+			t.Errorf("%+v was added", bad)
+		}
+	}
+}
