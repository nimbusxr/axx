diff --git a/server/apiv1/chaos_rules.go b/server/apiv1/chaos_rules.go
new file mode 100644
index 0000000..0fcf903
--- /dev/null
+++ b/server/apiv1/chaos_rules.go
@@ -0,0 +1,79 @@
+package apiv1
+
+// The chaos rules API, added by axx (github.com/nimbusxr/axx).
+
+import (
+	"encoding/json"
+	"net/http"
+
+	"github.com/axllent/mailpit/internal/smtpd/chaos"
+)
+
+// GetChaosRules returns the chaos rules.
+func GetChaosRules(w http.ResponseWriter, _ *http.Request) {
+	// swagger:route GET /api/v1/chaos/rules testing getChaosRules
+	//
+	// # Get chaos rules
+	//
+	// Returns the rules that refuse the mail of particular senders or recipients.
+	//
+	//	Produces:
+	//	  - application/json
+	//
+	//	Responses:
+	//	  200: ChaosRulesResponse
+	w.Header().Add("Content-Type", "application/json")
+	if err := json.NewEncoder(w).Encode(chaos.Rules()); err != nil {
+		httpError(w, err.Error())
+	}
+}
+
+// AddChaosRule adds a chaos rule.
+func AddChaosRule(w http.ResponseWriter, r *http.Request) {
+	// swagger:route POST /api/v1/chaos/rules testing addChaosRule
+	//
+	// # Add a chaos rule
+	//
+	// Refuse the mail of the senders or recipients that match, every time, until the rule is deleted.
+	//
+	//	Consumes:
+	//	  - application/json
+	//
+	//	Produces:
+	//	  - application/json
+	//
+	//	Responses:
+	//	  200: ChaosRuleResponse
+	//	  400: ErrorResponse
+	var rule chaos.Rule
+	if err := json.NewDecoder(r.Body).Decode(&rule); err != nil {
+		httpError(w, err.Error())
+		return
+	}
+	added, err := chaos.AddRule(rule)
+	if err != nil {
+		httpError(w, err.Error())
+		return
+	}
+	w.Header().Add("Content-Type", "application/json")
+	if err := json.NewEncoder(w).Encode(added); err != nil {
+		httpError(w, err.Error())
+	}
+}
+
+// DeleteChaosRule deletes a chaos rule.
+func DeleteChaosRule(w http.ResponseWriter, r *http.Request) {
+	// swagger:route DELETE /api/v1/chaos/rules/{ID} testing deleteChaosRule
+	//
+	// # Delete a chaos rule
+	//
+	//	Responses:
+	//	  200: OKResponse
+	//	  404: NotFoundResponse
+	if !chaos.DeleteRule(r.PathValue("id")) {
+		http.Error(w, "no such rule", http.StatusNotFound)
+		return
+	}
+	w.Header().Add("Content-Type", "text/plain")
+	_, _ = w.Write([]byte("ok"))
+}
