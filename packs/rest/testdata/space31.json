{
  "openapi": "3.1.0",
  "info": {"title": "Space test API (OpenAPI 3.1)", "version": "1.0"},
  "paths": {
    "/api/launches": {
      "post": {
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {"$ref": "#/components/schemas/Launch"},
              "examples": {
                "Second": {"value": {"name": "Second", "flight_number": 2, "tags": ["b"], "big": 12345678901234567890}},
                "First": {"value": {"name": "First", "flight_number": 1}}
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "created",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Launch"}}}
          }
        }
      }
    },
    "/api/launches/{id}": {
      "get": {
        "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "integer"}}],
        "responses": {
          "200": {
            "description": "one launch",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Launch"}}}
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Launch": {
        "type": "object",
        "required": ["name", "flight_number"],
        "properties": {
          "id": {"type": "integer"},
          "name": {"type": "string", "pattern": "^(?!forbidden).*$"},
          "flight_number": {"type": "integer", "exclusiveMinimum": 0},
          "kind": {"const": "rocket"},
          "note": {"type": ["string", "null"]},
          "tags": {"type": "array", "items": {"type": "string"}},
          "big": {"type": "integer"}
        },
        "additionalProperties": false
      }
    }
  }
}
