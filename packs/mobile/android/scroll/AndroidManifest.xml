<!-- axx's scroll service: it asks a view to scroll, or to show one of its controls, as a screen
     reader does. Nothing of it shows on the device, and it reaches no network: axx talks to it
     over adb. -->
<!-- The version's name is put in as axx builds it: what it was built from, which says whether a
     device has this one. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="us.nimbusxr.axx.scroll"
    android:versionCode="1">
  <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="35" />
  <application android:label="axx scroll" android:allowBackup="false">
    <service android:name=".Scrolls" android:exported="true" android:label="axx scroll"
        android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
      <intent-filter>
        <action android:name="android.accessibilityservice.AccessibilityService" />
      </intent-filter>
      <meta-data android:name="android.accessibilityservice" android:resource="@xml/service" />
    </service>
  </application>
</manifest>
