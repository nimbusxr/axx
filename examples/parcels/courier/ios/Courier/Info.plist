<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- What the build settings cannot say; Xcode merges the rest (GENERATE_INFOPLIST_FILE). -->
<plist version="1.0">
<dict>
	<!-- parcels-courier://deliveries/{reference} opens that delivery. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>example.parcels.courier</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>parcels-courier</string>
			</array>
		</dict>
	</array>
	<!-- Plain HTTP to the parcels service on the Mac the simulator runs on: 127.0.0.1. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
</dict>
</plist>
