<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- What the build settings cannot say; Xcode merges the rest (GENERATE_INFOPLIST_FILE). -->
<plist version="1.0">
<dict>
	<!-- parcels-courier://deliveries/{reference} opens that delivery. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>example.parcels.courier</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>parcels-courier</string>
			</array>
		</dict>
	</array>
	<!-- Where the van is, while the courier shares it. -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Recipients see where your van is on their tracking page while you share it.</string>
	<!-- The camera, which measures a parcel, scans its label and photographs it at the door. -->
	<key>NSCameraUsageDescription</key>
	<string>The camera measures a parcel to see that it fits a parcel locker, scans its label, and photographs it where you leave it.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Dictate a note about a delivery, and hear the doorbell or your knock when no one is home.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Turn your dictated delivery note into text.</string>
	<!-- The round reminder: a background task iOS runs now and then (RoundReminder.swift). -->
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>example.parcels.courier.round-reminder</string>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
	</array>
	<!-- Plain HTTP to the parcels service on the Mac the simulator runs on: 127.0.0.1. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
</dict>
</plist>
