{
  "openrpc": "1.3.2",
  "info": {
    "title": "Parcels depots",
    "version": "1.0.0",
    "description": "The depots' systems read a parcel, and hold it at the depot until a day, over JSON-RPC 2.0 (POST /rpc)."
  },
  "methods": [
    {
      "name": "parcel.get",
      "summary": "A parcel's status, and the day a depot holds it until",
      "params": [{"$ref": "#/components/contentDescriptors/Reference"}],
      "result": {"name": "parcel", "schema": {"$ref": "#/components/schemas/Parcel"}},
      "errors": [{"$ref": "#/components/errors/NoParcel"}]
    },
    {
      "name": "parcel.hold",
      "summary": "Hold a parcel at its depot until a day",
      "description": "A parcel can be held until it is out for delivery.",
      "paramStructure": "by-name",
      "params": [
        {"$ref": "#/components/contentDescriptors/Reference"},
        {"name": "until", "required": true, "schema": {"type": "string", "format": "date"}},
        {"name": "reason", "schema": {"type": "string", "maxLength": 120}}
      ],
      "result": {"name": "parcel", "schema": {"$ref": "#/components/schemas/Parcel"}},
      "errors": [{"$ref": "#/components/errors/NoParcel"}, {"$ref": "#/components/errors/NotHoldable"}]
    }
  ],
  "components": {
    "contentDescriptors": {
      "Reference": {"name": "reference", "required": true, "schema": {"type": "string", "pattern": "^PX-[A-Z0-9-]+$"}}
    },
    "schemas": {
      "Parcel": {
        "type": "object",
        "required": ["reference", "status", "serviceLevel", "weightGrams"],
        "properties": {
          "reference": {"type": "string"},
          "status": {"type": "string"},
          "serviceLevel": {"enum": ["STANDARD", "EXPRESS"]},
          "weightGrams": {"type": "integer"},
          "heldUntil": {"type": "string", "format": "date"}
        }
      }
    },
    "errors": {
      "NoParcel": {"code": 4004, "message": "No such parcel"},
      "NotHoldable": {
        "code": 4009,
        "message": "The parcel can no longer be held",
        "data": {"type": "object", "properties": {"status": {"type": "string"}}}
      }
    }
  }
}
