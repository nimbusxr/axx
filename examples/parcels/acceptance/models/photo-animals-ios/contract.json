{
  "format": {
    "type": "platform",
    "details": {
      "api": "ios.vision.animals"
    }
  },
  "task": "detection",
  "inputs": [
    {
      "name": "image",
      "type": "float32",
      "shape": [
        1,
        3,
        128,
        128
      ],
      "image": {
        "layout": "NCHW",
        "channels": "RGB",
        "resize": "stretch"
      }
    }
  ],
  "outputs": [
    {
      "name": "boxes",
      "type": "float32",
      "shape": [
        1,
        10,
        4
      ],
      "detection": "boxes",
      "box": {
        "order": "ymin,xmin,ymax,xmax"
      }
    },
    {
      "name": "classes",
      "type": "float32",
      "shape": [
        1,
        10
      ],
      "labels": [
        "Cat",
        "Dog"
      ],
      "detection": "classes"
    },
    {
      "name": "scores",
      "type": "float32",
      "shape": [
        1,
        10
      ],
      "detection": "scores"
    },
    {
      "name": "count",
      "type": "float32",
      "shape": [
        1
      ],
      "detection": "count"
    }
  ]
}
