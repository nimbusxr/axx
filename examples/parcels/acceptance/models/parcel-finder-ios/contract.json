{
  "format": {
    "type": "coreml",
    "version": 3,
    "details": {
      "confidence": "raw_confidence",
      "coordinates": "raw_coordinates",
      "candidates": 16
    }
  },
  "task": "detection",
  "inputs": [
    {
      "name": "imagePath",
      "type": "uint8",
      "shape": [
        3,
        416,
        416
