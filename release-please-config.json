{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "bump-minor-pre-major": true,
  "bump-patch-for-minor-pre-major": true,
  "include-v-in-tag": true,
  "prerelease": true,
  "bootstrap-sha": "73b1dcbf83155c945ed697dc7a3abaccb87cbe9b",
  "packages": {
    ".": {
      "release-type": "go",
      "include-component-in-tag": false,
      "exclude-paths": [
        "extensions",
        "ide",
        "docs",
        ".github",
        "examples"
      ],
      "changelog-path": "CHANGELOG.md"
    },
    "extensions/axx-wiremock": {
      "release-type": "simple",
      "package-name": "axx-wiremock",
      "component": "axx-wiremock",
      "include-component-in-tag": true,
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        {
          "type": "generic",
          "path": "gradle.properties"
        }
      ]
    },
    "ide/intellij": {
      "release-type": "simple",
      "package-name": "axx-intellij",
      "component": "intellij",
      "include-component-in-tag": true,
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        {
          "type": "generic",
          "path": "gradle.properties"
        }
      ]
    },
    "ide/vscode": {
      "release-type": "node",
      "package-name": "axx-vscode",
      "component": "vscode",
      "include-component-in-tag": true,
      "changelog-path": "CHANGELOG.md"
    }
  },
  "plugins": [
    {
      "type": "axx-stamp",
      "components": [
        "axx-wiremock",
        "intellij",
        "vscode"
      ]
    }
  ]
}
