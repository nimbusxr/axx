{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "bump-minor-pre-major": true,
  "bump-patch-for-minor-pre-major": true,
  "include-v-in-tag": true,
  "prerelease": true,
  "packages": {
    ".": {
      "release-type": "go",
      "package-name": "axx",
      "component": "axx",
      "include-component-in-tag": false,
      "exclude-paths": [
        "extensions",
        "ide",
        "docs",
        "evals"
      ],
      "changelog-path": "CHANGELOG.md"
    },
    "extensions/wiremock-openapi": {
      "release-type": "simple",
      "package-name": "axx-wiremock",
      "component": "wiremock-openapi",
      "include-component-in-tag": true,
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        {
          "type": "generic",
          "path": "gradle.properties"
        }
      ]
    },
    "ide/intellij": {
      "release-type": "simple",
      "package-name": "axx-intellij",
      "component": "intellij",
      "include-component-in-tag": true,
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        {
          "type": "generic",
          "path": "gradle.properties"
        }
      ]
    }
  }
}
